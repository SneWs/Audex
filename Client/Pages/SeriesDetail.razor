@page "/series/{Id:int}"
@using System.Net.Http.Json
@using Grenis.AudioBooks.Core
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-space-between mb-4">
    <div class="d-flex align-center">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/series" aria-label="Back to series" />
        <div class="ml-2">
            @if (_playlist is not null)
            {
                <MudText Typo="Typo.h4">@_playlist.Name</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary">
                    @($"{_playlist.Books.Count} {(_playlist.Books.Count == 1 ? "book" : "books")}")
                    @if (_playlist.IsAutoGenerated)
                    {
                        <span> · Auto-matched library series</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(_playlist.OwnerEmail))
                    {
                        <span> · @_playlist.OwnerEmail</span>
                    }
                </MudText>
            }
            else if (_loading)
            {
                <MudText Typo="Typo.h4">Series</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary">Loading…</MudText>
            }
            else
            {
                <MudText Typo="Typo.h4">Series</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary">This series could not be found.</MudText>
            }
        </div>
    </div>
    @if (_playlist?.CanEdit == true)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="DeleteAsync">Delete</MudButton>
    }
</div>

<MudDivider Class="mb-6" />

@if (_notFound)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/series">Back to Series</MudButton>
}
else
{
    <BookGrid Books="_books"
              EmptyTitle="No books in this series"
              EmptyIcon="@Icons.Material.Filled.QueueMusic"
              EmptyText="Books added to this series will appear here."
              OnFavoriteChanged="OnFavoriteChanged" />
}

@code {
    [Parameter] public int Id { get; set; }

    PlaylistDto? _playlist;
    BookDto[]? _books;
    bool _loading = true;
    bool _notFound;

    protected override Task OnParametersSetAsync() => LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        _playlist = null;
        _books = null;
        try
        {
            _playlist = await Http.GetFromJsonAsync<PlaylistDto>($"/api/playlists/{Id}");
            if (_playlist is null)
            {
                _notFound = true;
                _books = Array.Empty<BookDto>();
                return;
            }

            _books = _playlist.Books.ToArray();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _notFound = true;
            _books = Array.Empty<BookDto>();
        }
        catch
        {
            Snackbar.Add("Unable to load series.", Severity.Error);
            _books = Array.Empty<BookDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    void OnFavoriteChanged(BookDto book)
    {
        if (_books is null)
            return;

        _books = _books.Select(b => b.Id == book.Id ? book : b).ToArray();
    }

    async Task DeleteAsync()
    {
        if (_playlist is null || !_playlist.CanEdit)
            return;

        try
        {
            var response = await Http.DeleteAsync($"/api/playlists/{_playlist.Id}");
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Unable to delete series.", Severity.Error);
                return;
            }

            Snackbar.Add("Series deleted.", Severity.Success);
            Nav.NavigateTo("/series");
        }
        catch
        {
            Snackbar.Add("Unable to delete series.", Severity.Error);
        }
    }
}
